{
  "manifest_version": 3,
  "name": "TalkFlow - Google Meet Real-Time Live Translator",
  "version": "1.0.0",
  "description": "Real-time live multilingual captions and voice translation for Google Meet powered by TalkFlow AI.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TalkFlow Meet Translator"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
