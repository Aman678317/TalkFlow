{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "api": {
      "root": "services/api",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "installCommand": "pip install -r requirements.txt && python -c \"import shutil; shutil.copytree('../../multi-agent-portfolio', './multi_agent_portfolio', dirs_exist_ok=True)\""
    },
    "connect": {
      "root": "apps/amazon-connect-v2v/webapp",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api-docs",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/v2/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/v3/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/ws/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/ready",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/readyz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/metrics",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/connect",
      "destination": {
        "service": "connect",
        "path": "/"
      }
    },
    {
      "source": "/connect/:path*",
      "destination": {
        "service": "connect",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web",
        "path": "/index.html"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), display-capture=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}