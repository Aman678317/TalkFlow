{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite"
    },
    "api": {
      "root": "services/api",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "installCommand": "pip install -r requirements.txt && pip install ../../ai && python -c \"import shutil; shutil.copytree('../../ai/gt_ai', './gt_ai', dirs_exist_ok=True); shutil.copytree('../../multi-agent-portfolio', './multi_agent_portfolio', dirs_exist_ok=True)\""
    },
    "connect": {
      "root": "apps/amazon-connect-v2v/webapp",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api-docs",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/v2/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/v3/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/ws/:path*",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/ready",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/readyz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/metrics",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/connect",
      "destination": {
        "service": "connect",
        "path": "/"
      }
    },
    {
      "source": "/connect/:path*",
      "destination": {
        "service": "connect",
        "path": "/:path*"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
