# TalkFlow Audio Intelligence Agent Configuration

# Agent and API Server
AGENT_NAME=audio_intelligence_agent
AGENT_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8001
DEBUG=false
LOG_LEVEL=INFO

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_FRAME_DURATION_MS=50
AUDIO_RETENTION_POLICY=ephemeral

# Noise Suppression
NOISE_SUPPRESSION_ENABLED=true
NOISE_SUPPRESSION_PROVIDER=spectral

# Voice Activity Detection (VAD)
VAD_PROVIDER=silero
VAD_SPEECH_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=500
VAD_MAX_UTTERANCE_MS=15000
VAD_PARTIAL_INTERVAL_MS=1200
VAD_PHRASE_COMMIT_MS=4000

# Concurrency & Streaming
QUEUE_CAPACITY=100
MAX_CONCURRENT_SESSIONS=64

# OpenAI Agents SDK & LLM Brain (Ollama or OpenAI-compatible)
LLM_AGENT_ENABLED=true
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
LLM_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# TalkFlow Integration
TALKFLOW_API_URL=http://localhost:8000
TALKFLOW_SHARED_SECRET=talkflow-insecure-dev-secret

