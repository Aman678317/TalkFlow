{
  "name": "globaltalk-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/amazon-connect-v2v/webapp",
    "cli/desi-cli",
    "sdk/typescript",
    "developer-docs"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:docs": "npm --prefix developer-docs run dev",
    "dev:connect": "npm --prefix apps/amazon-connect-v2v/webapp run dev",
    "dev:cli": "npm --prefix cli/desi-cli run dev",
    "dev:photos": "npm --prefix apps/photo-organizer run dev",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "build:cli": "npm --prefix cli/desi-cli run build",
    "build:sdk": "npm --prefix sdk/typescript run build",
    "build:photos": "npm --prefix apps/photo-organizer run build",
    "build:all": "npm run build:web && npm run build:cli && npm run build:sdk",
    "test:web": "npm --prefix apps/web test",
    "test:cli": "npm --prefix cli/desi-cli test",
    "test:sdk": "npm --prefix sdk/typescript test",
    "test:photos": "npm --prefix apps/photo-organizer test",
    "test:all": "npm run test:web && npm run test:sdk",
    "preview": "npm --prefix apps/web run preview",
    "preview:photos": "npm --prefix apps/photo-organizer run preview",
    "start": "START_ALL.bat"
  }
}
