<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>Desi.Client</PackageId>
    <Version>2.0.0</Version>
    <Authors>GlobalTalk AI Authors</Authors>
    <Company>GlobalTalk AI</Company>
    <PackageDescription>Official production .NET client library for Desi Language AI. Provides native Indic translation, script transliteration, cultural honorific controls, and enterprise translation resource management.</PackageDescription>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/GlobalTalk-AI/desi-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/GlobalTalk-AI/desi-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>desi;indic;translation;transliteration;hindi;bengali;marathi;telugu;tamil;ai</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

</Project>
