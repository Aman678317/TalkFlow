# ---- Core ----
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:5173
SECRET_KEY=change-me-in-production-please-use-32+-random-bytes
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
# Names here MUST match the settings fields in services/api/app/config.py, which
# pydantic-settings reads as the upper-cased field name (no env prefix).
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
LOG_LEVEL=INFO

# ---- Database ----
# SQLite for dev; PostgreSQL or Supabase for prod:
DATABASE_URL=sqlite:///./data/globaltalk.db
# Supabase Transaction Pooler (Port 6543, recommended for Render/serverless):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Supabase Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DB_AUTOCREATE=true

# ---- Supabase (Optional Auth & Storage integration) ----
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- Cache / Redis ----
CACHE_BACKEND=memory            # memory (dev/fast-lane) | redis (production)
REDIS_URL=redis://localhost:6379/0

# ---- Object storage ----
STORAGE_BACKEND=local            # local | s3
STORAGE_LOCAL_PATH=./data/storage
LOCAL_STORAGE_PATH=./data/storage
S3_ENABLED=false
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=globaltalk
S3_ACCESS_KEY=replace-with-your-s3-access-key
S3_SECRET_KEY=replace-with-your-s3-secret-key
S3_REGION=us-east-1

# ---- LiveKit (optional in dev; WS audio transport is used when unset) ----
# Video calls need ALL FOUR: LIVEKIT_ENABLED=true plus a reachable URL and
# credentials. LIVEKIT_PUBLIC_URL is the browser-facing wss:// address;
# LIVEKIT_URL is the server-internal one (e.g. ws://livekit:7880 in docker).
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- P2P WebRTC ICE (WS-transport meetings) ----
# JSON list handed to RTCPeerConnection.iceServers; only room members can fetch
# it (GET /api/v1/meetings/{id}/ice-servers). Symmetric NAT / mobile carriers
# usually need TURN, e.g.
# [{"urls":["turn:turn.example.com:3478?transport=udp"],"username":"tk","credential":"pw"}]
# Leave empty for public STUN-only defaults.
WEBRTC_ICE_SERVERS_JSON=

# ---- AI models ----
MODEL_CACHE_PATH=/tmp/globaltalk-models
STT_PROVIDER=auto                # azure_speech | faster_whisper | stt_http | auto
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_HTTP_URL=                    # server-side STT gateway, never a browser URL
TRANSLATION_PROVIDER=auto        # azure_translator | deepl | mt_http | argos | auto
GPU_AVAILABLE=false              # true only in the optional NVIDIA GPU worker
AIRLLM_MODEL_ID=meta-llama/Llama-3.1-70B-Instruct
AIRLLM_HF_TOKEN=                 # server-only; required for gated Hugging Face models
AIRLLM_LAYER_SHARDS_PATH=        # defaults under MODEL_CACHE_PATH/airllm
AIRLLM_MAX_INPUT_TOKENS=512
AIRLLM_MAX_NEW_TOKENS=128
DEEPL_API_KEY=                   # server-only; never put this in VITE_* variables
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
MT_HTTP_URL=                     # authenticated server-side MT gateway, if used
MT_HTTP_STYLE=opennmt
# Azure adapters are server-side only. Install the optional Speech SDK extra
# before selecting azure_speech / azure_speech_tts; no Azure secret reaches the browser.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=en-US       # fallback locale when an utterance has no language hint
AZURE_SPEECH_AUTO_DETECT_LANGUAGES= # comma-separated BCP-47 candidates; blank uses Indic/global defaults
AZURE_SPEECH_VOICE_MAP=           # e.g. en=en-US-AriaNeural,hi=hi-IN-SwaraNeural
AZURE_TRANSLATOR_KEY=              # optional separate Translator resource key; Speech key is fallback
AZURE_TRANSLATOR_REGION=           # optional separate Translator region; Speech region is fallback
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_API_VERSION=3.0
TTS_PROVIDER=auto                # azure_speech_tts | kokoro | piper | tts_http | auto
TTS_HTTP_URL=                    # server-side TTS gateway, if used
# Which voice speaks which target language, e.g. TTS_VOICE_MAP=hi=hf_alpha,en=af_heart
# Empty = the provider's own default, which for Kokoro is a single English voice —
# correct for en, wrong for every other language in the room. Fill this in from
# the voice benchmark (python -m gt_ai.evaluation.tts --lang hi), not from a guess.
TTS_VOICE_MAP=
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
LANG_DETECT_PROVIDER=auto        # fasttext | langdetect | auto
FASTTEXT_LID_MODEL=
LLM_PROVIDER=none                # none | vllm
VLLM_BASE_URL=
VLLM_MODEL=
EMBEDDING_PROVIDER=hash          # hash | vllm
FEATURE_SEAMLESS_RESEARCH=false

# ---- Routing intents / latency ----
REALTIME_LATENCY_MODE=balanced   # ultra_low_latency | balanced | high_accuracy
VAD_PROVIDER=energy              # energy | silero
AUDIO_SAMPLE_RATE=16000
# Turn segmentation. VAD_MIN_SILENCE_MS is also the end-of-speech latency the
# listener waits before translation starts; see tests/unit/test_vad_cadence.py.
VAD_MIN_SPEECH_MS=250            # shorter bursts are a cough, not a turn
VAD_MIN_SILENCE_MS=500           # pause that closes a turn
VAD_MAX_SPEECH_MS=15000          # forced commit for a speaker who never pauses
VAD_PARTIAL_INTERVAL_MS=1200     # live-caption cadence
# Commit a long speaker's turn as soon as a live caption ends on a clause
# boundary, instead of waiting for the next breath. 0 = only silence/cap ends it.
VAD_PHRASE_COMMIT_MS=4000

# ---- Per-stage provider deadlines & inference budget (quality remediation) ----
# A stage that cannot finish in time fails that one language run down to a
# recoverable degradation (captions keep flowing); the call never hangs.
RT_STT_DEADLINE_MS=3000
RT_MT_DEADLINE_MS=2500
RT_TTS_TTFB_DEADLINE_MS=2000     # stream open + first audio chunk
# Max concurrent STT/MT/TTS model invocations in this process (shared gate).
RT_INFERENCE_CONCURRENCY=4

# ---- Context-aware writing (Tier 2 neural grammar) ----
# Any OpenAI-compatible chat endpoint (vLLM / llama.cpp / TGI). Leave empty to
# use only the offline rule engine. `llm_model` names the endpoint's model.
LLM_HTTP_URL=
LLM_MODEL=local-llm
WRITE_NEURAL_TIMEOUT_S=12

# ---- Observability ----
OTEL_ENDPOINT=
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ---- Security ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURE_COOKIES=false             # true behind HTTPS in staging/production
CSRF_ENABLED=true
RATE_LIMIT_TRANSLATE=60/minute
RATE_LIMIT_AUTH=300/minute
MAX_UPLOAD_MB=50
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=
# Development escape hatches. Both are OFF by default in EVERY mode (including
# local and CI) so no ambient backdoor exists; an operator must opt in explicitly.
#   ALLOW_TEST_AUTH  — accept wildcard test keys (`test-key-…` / `…:fx`) and mock
#                      social-provider tokens. Never enable in production.
#   ALLOW_SEED       — seed the demo/platform-admin users at startup.
ALLOW_TEST_AUTH=false
ALLOW_SEED=false

# ---- Social sign-in (Phase 2) ----
# Server-side verification credentials. A provider without a client id FAILS
# CLOSED: its ID tokens are refused because the audience cannot be validated —
# a valid signature is never enough on its own.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
# The SPA starts the same flows and needs the PUBLIC client ids only (secrets
# never belong in VITE_* variables — they would ship in the JS bundle).
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# ---- Phone calling: Asterisk local SIP adapter (optional, operator-controlled) ----
# Opt-in ARI adapter for the verified local-SIP lab (Asterisk 22.11; see
# docs/ASTERISK_LOCAL_SIP_LAB.md). Calls are restricted to allowlisted local
# extensions; no PSTN dialing, and no HTTP webhooks — events arrive over the
# authenticated ARI WebSocket. The simulated provider stays the CI default.
ASTERISK_TELEPHONY_ENABLED=false
ASTERISK_ARI_BASE_URL=             # e.g. http://127.0.0.1:8088
ASTERISK_ARI_USERNAME=             # dedicated least-privilege ARI user
ASTERISK_ARI_PASSWORD=
ASTERISK_ARI_APP_NAME=talkflow
ASTERISK_ALLOWED_EXTENSIONS=       # comma-separated, e.g. 1001,1002
ASTERISK_REQUEST_TIMEOUT_SECONDS=10
ASTERISK_EVENT_RETRY_SECONDS=2
ASTERISK_WS_RECONNECT_SECONDS=5
# NOTE: ARI defaults to port 8088. If the API itself binds 8088 on the same
# host (run_api.py), point Asterisk's http.conf at another port and use that
# here so the two services never collide.
