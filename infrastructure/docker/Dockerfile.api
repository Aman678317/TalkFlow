# GlobalTalk AI — API image (control plane + data plane + WS realtime)
FROM python:3.12-slim AS base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 MALLOC_ARENA_MAX=2

WORKDIR /app

# system deps: ffmpeg for audio handling in production media paths
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt apps/api/requirements.txt
COPY services/api/requirements.txt services/api/requirements.txt
RUN pip install -r apps/api/requirements.txt -r services/api/requirements.txt

COPY ai/ ai/
COPY services/ services/
COPY apps/api/ apps/api/

ENV PYTHONPATH=/app/services/api:/app/apps/api:/app/ai:/app \
    MODEL_CACHE_PATH=/models \
    STORAGE_LOCAL_PATH=/data/storage \
    APP_MODULE=app.main:app

VOLUME ["/models", "/data"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
  CMD curl -fsS http://localhost:8000/health || exit 1

WORKDIR /app/services/api
# One uvicorn process, deliberately: the realtime routing tables
# (app/realtime/session_manager.py) are in-memory, so anything above
# --workers 1 silently splits a meeting's participants across processes and
# listeners stop receiving captions/translation events (the E2E smoke caught
# exactly this). Horizontal scaling needs the shared-registry milestone first.
CMD ["sh", "-c", "python -m uvicorn ${APP_MODULE} --host 0.0.0.0 --port ${API_PORT:-8000} --workers 1"]
