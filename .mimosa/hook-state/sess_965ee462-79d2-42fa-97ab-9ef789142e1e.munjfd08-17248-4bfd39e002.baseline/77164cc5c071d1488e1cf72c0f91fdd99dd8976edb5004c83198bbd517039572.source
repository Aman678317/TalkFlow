{
  "name": "@globaltalk/sdk",
  "version": "0.1.0",
  "description": "Official Node.js / TypeScript client for the GlobalTalk AI API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build":     "tsc -p tsconfig.json",
    "dev":       "tsc -p tsconfig.json --watch",
    "test":      "node --experimental-vm-modules node_modules/.bin/jest",
    "lint":      "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["globaltalk", "translation", "ai", "desi", "nlp", "sdk"],
  "license": "MIT",
  "files": ["dist", "src", "README.md"],
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node":      "^20.0.0",
    "@types/node-fetch": "^3.0.0",
    "typescript":       "^5.4.0",
    "jest":             "^29.0.0",
    "ts-jest":          "^29.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
