package com.desi.api.exceptions;

/**
 * Thrown when the account character or document translation quota has been exceeded.
 */
public class QuotaExceededException extends DesiException {
    public QuotaExceededException(String message) {
        super(message, 456);
    }

    public QuotaExceededException(String message, Throwable cause) {
        super(message, 456, cause);
    }
}
