package com.desi.api.model;

import com.desi.api.Tone;
import com.desi.api.WritingStyle;

/**
 * Options for Desi Write text improvement requests.
 */
public class RephraseOptions {
    private WritingStyle writingStyle;
    private Tone tone;

    public WritingStyle getWritingStyle() {
        return writingStyle;
    }

    public RephraseOptions setWritingStyle(WritingStyle writingStyle) {
        this.writingStyle = writingStyle;
        return this;
    }

    public Tone getTone() {
        return tone;
    }

    public RephraseOptions setTone(Tone tone) {
        this.tone = tone;
        return this;
    }
}
