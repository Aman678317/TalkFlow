package com.desi.api;

/**
 * Tag handling strategy for XML and HTML markup.
 */
public enum TagHandling {
    XML("xml"),
    HTML("html");

    private final String value;

    TagHandling(String value) {
        this.value = value;
    }

    public String getValue() {
        return value;
    }

    @Override
    public String toString() {
        return value;
    }
}
