class WebhookCreate(BaseModel):
    url: str = Field(min_length=8, max_length=500)
    events: list[str] = Field(default_factory=list)

    @field_validator("url")
    @classmethod
    def _no_local(cls, v: str) -> str:
        # SSRF guard: reject obvious internal targets at creation time;
        # delivery re-checks resolved IPs.
        import urllib.parse
        p = urllib.parse.urlparse(v)
        if p.scheme not in ("https", "http"):
            raise ValueError("webhook url must be http(s)")
        host = (p.hostname or "").lower()
        blocked = ("localhost", "127.", "0.0.0.0", "169.254.", "[::1]", "metadata.google")
        if host.startswith(blocked) or host in ("10.", "192.168."):
            from app.config import settings as _s
            if _s.is_production:
                raise ValueError("internal addresses are not allowed in production")
        return v


class WebhookOut(ORMModel):
    id: uuid.UUID
    url: str
    events: list
    status: str
    created_at: datetime


