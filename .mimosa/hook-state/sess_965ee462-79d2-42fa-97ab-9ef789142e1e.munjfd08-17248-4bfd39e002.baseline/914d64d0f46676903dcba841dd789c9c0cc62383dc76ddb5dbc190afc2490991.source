"""Pydantic schemas — API contracts (mirrored in packages/shared-types)."""
from __future__ import annotations

import uuid
from datetime import datetime
from typing import Any, Literal

from pydantic import BaseModel, ConfigDict, EmailStr, Field, field_validator

# --------------------------------------------------------------------------- #
# Common
# --------------------------------------------------------------------------- #


class ORMModel(BaseModel):
    model_config = ConfigDict(from_attributes=True)


class Page(BaseModel):
    items: list[Any]
    total: int
    limit: int
    offset: int


# --------------------------------------------------------------------------- #
# Auth
# --------------------------------------------------------------------------- #


class SignupRequest(BaseModel):
    email: str = Field(min_length=3, max_length=256)
    password: str = Field(min_length=8, max_length=256)
    name: str = Field(default="", max_length=200)
    organization_name: str = Field(default="", max_length=200)
    locale: str = "en"

    @field_validator("email")
    @classmethod
    def _validate_email(cls, v: str) -> str:
        v = v.strip().lower()
        if "@" not in v or "." not in v.split("@")[-1]:
            raise ValueError("Invalid email format")
        return v


class LoginRequest(BaseModel):
    email: str = Field(min_length=3, max_length=256)
    password: str
    org_id: str | None = None  # optional explicit organization (multi-org users)

    @field_validator("email")
    @classmethod
    def _validate_email(cls, v: str) -> str:
        return v.strip().lower()


class TokenPair(BaseModel):
    access_token: str
    refresh_token: str
    token_type: str = "bearer"
    expires_in: int


class RefreshRequest(BaseModel):
    refresh_token: str


class UserOut(ORMModel):
    id: uuid.UUID
    email: str
    name: str
    locale: str
    speak_lang: str
    hear_lang: str
    email_verified: bool
    mfa_enabled: bool
    is_platform_admin: bool
    created_at: datetime


class OrgMemberOut(ORMModel):
    id: uuid.UUID
