    created_at: datetime
    user: UserOut | None = None


class OrganizationOut(ORMModel):
    id: uuid.UUID
    name: str
    slug: str
    plan: str
    status: str
    created_at: datetime


class PasswordResetRequest(BaseModel):
    email: str = Field(min_length=3, max_length=256)

    @field_validator("email")
    @classmethod
    def _validate_email(cls, v: str) -> str:
        return v.strip().lower()


class PasswordResetConfirm(BaseModel):
    token: str
    new_password: str = Field(min_length=8, max_length=256)


class SessionOut(ORMModel):
    id: uuid.UUID
    device_info: str
    last_seen_at: datetime | None
    created_at: datetime
    revoked_at: datetime | None


class UpdateProfileRequest(BaseModel):
    name: str | None = Field(default=None, max_length=200)
    locale: str | None = None
    speak_lang: str | None = None
    hear_lang: str | None = None


class ChangePasswordRequest(BaseModel):
    current_password: str
    new_password: str = Field(min_length=8, max_length=256)


# --------------------------------------------------------------------------- #
# Translation
# --------------------------------------------------------------------------- #

ModelIntent = Literal["latency_optimized", "quality_optimized", "cost_optimized", "private_only"]


class TranslateRequest(BaseModel):
    text: str | list[str] = Field(min_length=1)
    source_language: str = "AUTO"
    target_language: str = Field(min_length=2, max_length=8)
    glossary_id: uuid.UUID | None = None
    style_profile_id: uuid.UUID | None = None
    translation_memory_id: uuid.UUID | None = None
    domain: str = "general"
    intent: ModelIntent = "quality_optimized"
    batch: bool = False

    @field_validator("text")
    @classmethod
    def _check_text(cls, v):
        items = v if isinstance(v, list) else [v]
        if not items:
            raise ValueError("text must not be empty")
        if len(items) > 100:
            raise ValueError("batch limit is 100 texts per request")
        for t in items:
            if not isinstance(t, str) or len(t) > 50_000:
                raise ValueError("each text must be a string <= 50000 chars")
        return v


class TranslationOut(BaseModel):
    translation_id: uuid.UUID
    source_language: str
    target_language: str
    source_text: str
    translated_text: str
    model: str
    provider: str
    latency_ms: float
    quality_flags: list[str]
    tm_match: str | None = None
    domain: str = "general"


class TranslateResponse(BaseModel):
    translations: list[TranslationOut]
    request_id: str


class DetectRequest(BaseModel):
    text: str = Field(min_length=1, max_length=10_000)


class DetectResponse(BaseModel):
    language: str
    confidence: float
    alternatives: list[tuple[str, float]]
    provider: str


