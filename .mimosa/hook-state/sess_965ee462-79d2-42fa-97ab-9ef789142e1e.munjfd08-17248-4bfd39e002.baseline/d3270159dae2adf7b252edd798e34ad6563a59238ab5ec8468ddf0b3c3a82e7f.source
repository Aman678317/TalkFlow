export function findLanguage(codeOrName: string): LanguageInfo | undefined {
  const normalized = codeOrName.trim().toLowerCase();
  return GLOBAL_LANGUAGES.find(
    (l) => l.code.toLowerCase() === normalized || l.name.toLowerCase() === normalized
  );
}

export function isIndicLanguage(codeOrName: string): boolean {
  const lang = findLanguage(codeOrName);
  return Boolean(lang?.isIndic);
}
