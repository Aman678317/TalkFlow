package com.desi.api.model;

import com.desi.api.DesiFormality;

/**
 * Options for customizing document translation requests.
 */
public class DocumentTranslationOptions {
    private DesiFormality formality;
    private String glossaryId;
    private boolean enableMinification = false;
    private String styleRuleId;
    private String translationMemoryId;

    public DesiFormality getFormality() {
        return formality;
    }

    public DocumentTranslationOptions setFormality(DesiFormality formality) {
        this.formality = formality;
        return this;
    }

    public String getGlossaryId() {
        return glossaryId;
    }

    public DocumentTranslationOptions setGlossaryId(String glossaryId) {
        this.glossaryId = glossaryId;
        return this;
    }

    public boolean isEnableMinification() {
        return enableMinification;
    }

    public DocumentTranslationOptions setEnableMinification(boolean enableMinification) {
        this.enableMinification = enableMinification;
        return this;
    }

    public String getStyleRuleId() {
        return styleRuleId;
    }

    public DocumentTranslationOptions setStyleRuleId(String styleRuleId) {
        this.styleRuleId = styleRuleId;
        return this;
    }

    public String getTranslationMemoryId() {
        return translationMemoryId;
    }

    public DocumentTranslationOptions setTranslationMemoryId(String translationMemoryId) {
        this.translationMemoryId = translationMemoryId;
        return this;
    }
}
