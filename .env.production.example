# ---- Core ----
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:5173
SECRET_KEY=change-me-in-production-please-use-32+-random-bytes
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=INFO

# ---- Database ----
# SQLite for dev; PostgreSQL for prod, e.g.
# DATABASE_URL=postgresql+psycopg://globaltalk:globaltalk@localhost:5432/globaltalk
DATABASE_URL=postgresql+psycopg://globaltalk:CHANGE_ME@postgres:5432/globaltalk
DB_AUTOCREATE=false

# ---- Redis (optional in dev; required in prod) ----
REDIS_URL=redis://redis:6379/0

# ---- Object storage ----
STORAGE_BACKEND=s3            # local | s3
STORAGE_LOCAL_PATH=./data/storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=globaltalk
S3_ACCESS_KEY=replace-with-your-s3-access-key
S3_SECRET_KEY=replace-with-your-s3-secret-key
S3_REGION=us-east-1

# ---- LiveKit (optional in dev; WS audio transport is used when unset) ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- P2P WebRTC ICE (WS-transport meetings) ----
# JSON list handed to RTCPeerConnection.iceServers; GET /api/v1/meetings/{id}/
# ice-servers serves it to seated participants and org members only. Mobile
# carriers and symmetric NATs usually need TURN for any media to flow:
# e.g. [{"urls":["turn:turn.example.com:3478?transport=udp"],"username":"tk","credential":"pw"}]
# Leave empty to fall back to public STUN-only defaults.
WEBRTC_ICE_SERVERS_JSON=

# ---- AI models ----
MODEL_CACHE_PATH=/tmp/globaltalk-models
STT_MODEL=Systran/faster-whisper-small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TRANSLATION_PROVIDER=auto        # auto | argos | fallback
TTS_PROVIDER=auto                # auto | kokoro | none
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
LLM_PROVIDER=none                # none | vllm
VLLM_BASE_URL=
VLLM_MODEL=
EMBEDDING_PROVIDER=hash          # hash | vllm
FEATURE_SEAMLESS_RESEARCH=false

# ---- Routing intents / latency ----
REALTIME_LATENCY_MODE=balanced   # ultra_low_latency | balanced | high_accuracy
VAD_PROVIDER=energy              # energy | silero
AUDIO_SAMPLE_RATE=16000

# ---- Per-stage provider deadlines & inference budget (quality remediation) ----
RT_STT_DEADLINE_MS=3000
RT_MT_DEADLINE_MS=2500
RT_TTS_TTFB_DEADLINE_MS=2000
RT_INFERENCE_CONCURRENCY=4

# ---- Context-aware writing (Tier 2 neural grammar) ----
LLM_HTTP_URL=
LLM_MODEL=local-llm
WRITE_NEURAL_TIMEOUT_S=12

# ---- Observability ----
OTEL_ENDPOINT=
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ---- Security ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_TRANSLATE=60/minute
RATE_LIMIT_AUTH=10/minute
UPLOAD_MAX_MB=50
MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=
